<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: bin/setup --services fills __HOME__ and installs it into ~/Library/LaunchAgents.
     Tabbie Team mirror (bin/tt daemon). Idles until a team is set up and a project is shared (Settings → Team). -->
<plist version="1.0"><dict>
  <key>Label</key><string>ai.hermes.team</string>
  <key>ProgramArguments</key><array><string>__HOME__/hermes/bin/tt</string><string>daemon</string></array>
  <key>EnvironmentVariables</key><dict><key>HOME</key><string>__HOME__</string><key>PATH</key><string>__HOME__/.hermes/bin:__HOME__/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string></dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>__HOME__/hermes/state/logs/team.log</string>
  <key>StandardErrorPath</key><string>__HOME__/hermes/state/logs/team.log</string>
</dict></plist>
