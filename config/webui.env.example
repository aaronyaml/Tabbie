# Settings for the upstream Hermes WebUI (hermes-webui/.env). `bin/setup` writes hermes-webui/.env
# from this file with your home folder filled in. Set the password yourself (never commit it):
#   HERMES_WEBUI_PASSWORD=...   or keep it in the Keychain (see README).
HERMES_WEBUI_HOST=127.0.0.1
HERMES_WEBUI_PORT=8787
HERMES_WEBUI_DEFAULT_WORKSPACE=__HOME__/hermes/general
HERMES_WEBUI_AGENT_DIR=__HOME__/.hermes/hermes-agent
HERMES_WEBUI_AGENT_CACHE_MAX=6
HERMES_WEBUI_SESSIONS_MAX=40
HERMES_WEBUI_EXTENSION_DIR=__HOME__/hermes/webui-extension
HERMES_WEBUI_EXTENSION_MANIFEST=extensions.json
MEDIA_ALLOWED_ROOTS=__HOME__/hermes/state/requests:__HOME__/hermes/brand
HERMES_WEBUI_MAX_UPLOAD_MB=200
# Tabbie's bin/setup signs the hub in with your ChatGPT or Claude login, so the WebUI's own
# first-run wizard (API-key providers) is skipped.
HERMES_WEBUI_SKIP_ONBOARDING=1
