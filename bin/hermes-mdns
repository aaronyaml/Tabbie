#!/bin/bash
# Publishes hermes.local on the home
# network via Bonjour, for every Wi-Fi and Ethernet address it has. Not just the default route's: with a
# VPN on, the default route is the tunnel, which phones on the Wi-Fi can't reach. Rechecks every 10 s, so
# a new network, a wake from sleep or a VPN switching on or off is picked up. The Mac's own hostname is
# untouched. Run by launchd.
NAME="${HERMES_MDNS_NAME:-hermes.local}"
PIDS=(); ips=""
cleanup() { for p in "${PIDS[@]}"; do kill "$p" 2>/dev/null; done; exit 0; }
trap cleanup TERM INT
lan_ips() {  # IPv4 on physical Wi-Fi/Ethernet ports (en*), skipping VPN tunnels, bridges and link-local
  local ifc ip
  for ifc in $(ifconfig -l 2>/dev/null); do
    case "$ifc" in en*) ;; *) continue ;; esac
    ip="$(ipconfig getifaddr "$ifc" 2>/dev/null)"
    case "$ip" in ""|169.254.*) ;; *) echo "$ip" ;; esac
  done | sort -u | tr '\n' ' '
}
alive() { local p; for p in "${PIDS[@]}"; do kill -0 "$p" 2>/dev/null || return 1; done; }
n=0
while true; do
  new="$(lan_ips)"
  if [ "$new" != "$ips" ] || ! alive; then
    for p in "${PIDS[@]}"; do kill "$p" 2>/dev/null; wait "$p" 2>/dev/null; done
    PIDS=(); ips="$new"; n=0
    for ip in $ips; do
      n=$((n + 1))
      /usr/bin/dns-sd -P "Tabbie $n" _https._tcp local 443 "$NAME" "$ip" path=/ >/dev/null 2>&1 &
      PIDS+=($!)
    done
    echo "$(date '+%F %T') published $NAME -> ${ips:-nothing (no Wi-Fi or Ethernet address)}"
  fi
  sleep 10
done
