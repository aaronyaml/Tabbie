#!/bin/bash
# Tabbie's address is always hermes.local. This only picks Caddy's admin address.
#   tabbie-host            print the address (hermes.local)
#   tabbie-host --admin    the Caddy admin address (localhost:2019 unless something else holds that port)
STATE="$(cd "$(dirname "$0")/.." && pwd)/state"
case "$1" in
  --admin)
    a="$(cat "$STATE/caddy-admin" 2>/dev/null)"
    if [ -z "$a" ]; then
      for p in 2019 2029 2039 2049 2059; do
        who="$(lsof -nP -iTCP:$p -sTCP:LISTEN -Fc 2>/dev/null | sed -n 's/^c//p' | head -1)"
        { [ -z "$who" ] || [ "$who" = caddy ]; } && { a="localhost:$p"; break; }
      done
      a="${a:-localhost:2019}"
      mkdir -p "$STATE" && printf '%s\n' "$a" > "$STATE/caddy-admin"
    fi
    echo "$a" ;;
  *) echo hermes.local ;;
esac
