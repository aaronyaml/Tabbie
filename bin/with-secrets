#!/usr/bin/env python3
"""Run a command with the secrets from Tabbie's 1Password vault as environment variables.

    with-secrets -- npm run deploy                  # every secret in the vault
    with-secrets --only RESEND_API_KEY -- node send.js
    with-secrets --list                             # variable names only (never values)

The values come from 1Password (its SDK, via op_sdk.py `run`; no `op` CLI, so no macOS permission prompts):
they exist only in that command's environment, and any value the command prints is masked. The 1Password service account token itself is NOT passed on to the command.
Nothing here ever prints a secret value.
"""
import importlib
import os
import subprocess
import sys
import tempfile
import types
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))
pkg = types.ModuleType("cc_sidecar_pkg")
pkg.__path__ = [str(ROOT / "plugin" / "command-centre")]
sys.modules["cc_sidecar_pkg"] = pkg
secrets = importlib.import_module("cc_sidecar_pkg.secrets")


def main(argv: list[str]) -> int:
    only = None
    if argv[:1] == ["--list"]:
        try:
            if not secrets._token():
                print("with-secrets: no secret store set up on this Mac (1Password isn't connected). Ask the user to "
                      "set it up in Settings → Accounts → Secrets, or to give you the key another way.", file=sys.stderr)
                return 1
            refs = secrets.env_refs(strict=True)
        except secrets.SecretError as exc:
            print(f"with-secrets: couldn't reach the secret store: {exc}", file=sys.stderr)
            return 1
        print("\n".join(sorted(refs)) if refs else "(no secrets in the vault yet)")
        return 0
    if argv[:1] == ["--only"] and len(argv) > 1:
        only = {x.strip().upper() for x in argv[1].split(",") if x.strip()}
        argv = argv[2:]
    if argv[:1] == ["--"]:
        argv = argv[1:]
    if not argv:
        print(__doc__.strip(), file=sys.stderr)
        return 2
    try:
        refs = secrets.env_refs(strict=True)
        env = secrets.op_env()
    except secrets.SecretError as exc:
        print(f"with-secrets: {exc}", file=sys.stderr)
        return 1
    if only is not None:
        missing = only - set(refs)
        if missing:
            print(f"with-secrets: not in the vault: {', '.join(sorted(missing))}", file=sys.stderr)
            return 1
        refs = {k: v for k, v in refs.items() if k in only}
    fd, path = tempfile.mkstemp(prefix="tabbie-secrets-", suffix=".env")  # references only, no values
    try:
        with os.fdopen(fd, "w") as fh:
            fh.write("".join(f'{k}="{v}"\n' for k, v in refs.items()))
        # env -u: the command gets the secrets, not the key to the whole vault
        return subprocess.call(secrets.sdk_cmd(["run", "--env-file", path, "--", *argv]), env=env)
    finally:
        os.unlink(path)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
