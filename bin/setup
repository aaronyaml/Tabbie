#!/bin/bash
# setup — first-time install for Tabbie (the Hermes command centre). Safe to re-run.
#   bin/setup              check prerequisites, write local files, link plugins
#   bin/setup --services   also install + start the LaunchAgents (WebUI, HTTPS proxy, mDNS, sidecar, Dreamer)
# Nothing here asks for or stores an API key: every provider signs in with its own OAuth login.
set -euo pipefail
HERMES="$HOME/hermes"
cd "$HERMES" 2>/dev/null || { echo "Clone this repo to ~/hermes first (other locations aren't supported yet)."; exit 1; }
ok()   { printf '  \033[32m✓\033[0m %s\n' "$1"; }
warn() { printf '  \033[33m!\033[0m %s\n' "$1"; }
need() { if command -v "$1" >/dev/null 2>&1; then ok "$1"; else warn "$1 missing — $2"; MISSING=1; fi; }

echo "Prerequisites"
MISSING=0
[ "$(uname)" = Darwin ] && ok "macOS" || warn "not macOS: services (launchd, Bonjour) won't work; the rest may"
need python3 "install Python 3.11+ (python.org or brew install python)"
need git     "xcode-select --install"
need uv      "curl -LsSf https://astral.sh/uv/install.sh | sh"
need hermes  "install Hermes Agent: https://github.com/NousResearch/hermes-agent"
need claude  "install Claude Code: https://docs.anthropic.com/claude-code"
command -v codex >/dev/null 2>&1 && ok "codex (optional planner)" || warn "codex missing (optional: Astra planner) — npm i -g @openai/codex"
command -v caddy >/dev/null 2>&1 && ok "caddy (optional HTTPS)" || warn "caddy missing (optional: https://hermes.local) — brew install caddy"

echo "Local files"
mkdir -p state/logs state/requests general workspaces
chmod 700 state
[ -f config/projects.yaml ] || { cp config/projects.example.yaml config/projects.yaml; ok "config/projects.yaml"; }
if [ ! -f webui-extension/local.js ]; then
  NAME="$(id -F 2>/dev/null | awk '{print $1}')"
  cat > webui-extension/local.js <<JS
// Per-machine settings (git-ignored). Regenerate with bin/setup.
window.HX_LOCAL = {
  home: "$HOME",
  hermes: "$HERMES",
  motion: "$HOME/motion",
  name: "${NAME}",
};
JS
  ok "webui-extension/local.js"
fi
if [ ! -d hermes-webui ]; then
  git clone -q https://github.com/nesquena/hermes-webui.git hermes-webui && ok "hermes-webui (upstream WebUI) cloned"
fi
if [ ! -f hermes-webui/.env ]; then
  sed "s|__HOME__|$HOME|g" config/webui.env.example > hermes-webui/.env
  chmod 600 hermes-webui/.env
  ok "hermes-webui/.env (set HERMES_WEBUI_PASSWORD in it before exposing the WebUI)"
fi
PYTHONPATH="$HERMES" python3 -m hmem.cli init >/dev/null && ok "memory store (memory/, its own git repo)"

if ! grep -q "## Command Centre role" "$HOME/.hermes/SOUL.md" 2>/dev/null; then
  mkdir -p "$HOME/.hermes"; { echo; tail -n +2 config/SOUL.hub.md; } >> "$HOME/.hermes/SOUL.md" && ok "hub rules → ~/.hermes/SOUL.md"
fi

echo "Hermes plugins"
mkdir -p "$HOME/.hermes/plugins"
for p in command-centre fragment-memory limits workboard; do
  ln -sfn "$HERMES/plugin/$p" "$HOME/.hermes/plugins/$p" && ok "~/.hermes/plugins/$p"
done

if [ "${1:-}" = "--services" ]; then
  echo "LaunchAgents"
  CADDY="$(command -v caddy || echo /opt/homebrew/bin/caddy)"
  for t in services/*.plist.template; do
    label="$(basename "$t" .plist.template)"
    [ "$label" = ai.hermes.caddy ] && ! command -v caddy >/dev/null && { warn "skip $label (no caddy)"; continue; }
    dest="$HOME/Library/LaunchAgents/$label.plist"
    sed -e "s|__HOME__|$HOME|g" -e "s|__CADDY__|$CADDY|g" "$t" > "$dest"
    launchctl bootout "gui/$(id -u)/$label" 2>/dev/null || true
    launchctl bootstrap "gui/$(id -u)" "$dest" && ok "$label"
  done
  hermes gateway install >/dev/null 2>&1 && ok "Hermes gateway service" || warn "run: hermes gateway install"
fi

echo
[ "$MISSING" = 0 ] || echo "Install the missing tools above, then re-run bin/setup."
echo "Next: sign in to each provider (README → Sign in), then: bin/hub health"
