#!/bin/bash
# setup — opens Tabbie's setup page in your browser (served only to this Mac).
#   bin/setup              the setup page
#   bin/setup --terminal   the same steps in this Terminal window instead (bin/setup-terminal)
#   bin/setup --yes …      no questions, defaults (also runs in the Terminal; see bin/setup-terminal)
set -uo pipefail
HERMES="$HOME/hermes"
cd "$HERMES" 2>/dev/null || { echo "Clone this repo to ~/hermes first (other locations aren't supported yet)."; exit 1; }

# Headless or scripted runs, and anyone who prefers the Terminal, get the Terminal version.
for a in "$@"; do
  case "$a" in --terminal) shift; exec bin/setup-terminal "$@" ;; --yes|-y|--only|--agents|--name|--services|--hub) exec bin/setup-terminal "$@" ;; esac
done
[ -t 0 ] || exec bin/setup-terminal "$@"

# The page runs on Python, which comes with Apple's free developer tools (they also bring git).
if ! xcode-select -p >/dev/null 2>&1 || ! /usr/bin/python3 -c 'import sys' >/dev/null 2>&1; then
  echo
  echo "  Tabbie needs Apple's free developer tools first (git and Python)."
  echo "  A window from Apple is opening: click Install, and wait for it to finish (a few minutes)."
  xcode-select --install >/dev/null 2>&1
  printf '  Waiting'
  until xcode-select -p >/dev/null 2>&1 && /usr/bin/python3 -c 'import sys' >/dev/null 2>&1; do printf '.'; sleep 5; done
  echo " done."
fi
PY="$(command -v python3 || echo /usr/bin/python3)"
exec "$PY" -I "$HERMES/setup/server.py"
