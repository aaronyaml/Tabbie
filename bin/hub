#!/bin/bash
# hub — one command for the Hermes command centre.
#   hub              open Hermes WebUI (https://hermes.local)
#   hub cli          Hermes in the terminal (same config, routing, sessions)
#   hub health       lightweight health check of every component
#   hub restart      install any missing service, then restart gateway + WebUI + proxy + mDNS
#   hub services     install any background service that's missing (e.g. one added by an update)
#   hub logs [name]  tail logs: webui | gateway | caddy | mdns | sidecar | decisions
#   hub import       import Claude project folders into Hermes + WebUI spaces
#   hub limits       usage limits: Claude Max, ChatGPT (Astra + hub), Higgsfield, ElevenLabs
#   hub update       check GitHub for a newer Tabbie, and download it if you say yes
export PATH="$HOME/.hermes/bin:$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
UID_=$(id -u)
ok()   { printf '  \033[32m✓\033[0m %s\n' "$1"; }
bad()  { printf '  \033[31m✗\033[0m %s\n' "$1"; }
check() { if eval "$2" >/dev/null 2>&1; then ok "$1"; else bad "$1${3:+ — $3}"; fi; }
opt()   { if eval "$2" >/dev/null 2>&1; then ok "$1"; else printf '  \033[33m!\033[0m %s\n' "$1 (optional)${3:+ — $3}"; fi; }

case "${1:-open}" in
  open) open "https://hermes.local" ;;
  cli) shift; exec hermes "$@" ;;
  health)
    echo "Hermes command centre"
    check "Hermes gateway (launchd)"  "hermes gateway status | grep -q -E 'running|supervised'" "hermes gateway install"
    check "Hermes WebUI"              "curl -sf -m 5 http://127.0.0.1:8787/health" "hub logs webui"
    check "HTTPS proxy (Caddy)"       "launchctl list ai.hermes.caddy | grep -q '\"PID\"'" "hub logs caddy"
    check "Tabbie helper (cc-sidecar)" "launchctl list ai.hermes.cc-sidecar | grep -q '\"PID\"'" "bin/setup --services (installs it), then hub logs sidecar"
    check "hermes.local (mDNS)"       "dscacheutil -q host -a name hermes.local | grep -q ip_address" "hub logs mdns"
    check "WebUI via hermes.local"    "curl -sk -m 5 -o /dev/null -w '%{http_code}' https://hermes.local/login | grep -q 200"
    PL="$(hermes plugins list 2>/dev/null)"
    for p in command-centre fragment-memory limits workboard; do
      check "Plugin $p enabled"       "printf '%s' \"\$PL\" | grep -E '^. $p ' | grep -q enabled" "hermes plugins enable $p, then bin/hub restart"
    done
    AGENTS_ON="$(sed -n 's/^enabled:[[:space:]]*\[\(.*\)\]/\1/p' "$HOME/hermes/config/agents.yaml" 2>/dev/null)"
    [ -n "$AGENTS_ON" ] || AGENTS_ON="claude, codex"  # no file = both (older installs)
    case "$AGENTS_ON" in *claude*)
    check "Claude (Max OAuth)"        "claude auth status | grep -q '\"authMethod\": \"claude.ai\"'" "claude auth login" ;; esac
    case "$AGENTS_ON" in *codex*)
    check "OpenAI/Astra (ChatGPT)"    "codex login status 2>&1 | grep -q ChatGPT" "codex login" ;; esac
    check "Hermes hub signed in"      "hermes auth list | grep -qiE 'oauth|api|token'" "hermes setup"
    case "$AGENTS_ON" in *codex*)
    check "Astra model exposed"       "grep -q '\"gpt-6-astra\"' ~/.codex/models_cache.json" ;; esac
    opt   "Higgsfield"                "higgsfield account status" "higgsfield auth login"
    opt   "ElevenLabs MCP (OAuth)"    "test -s ~/.hermes/mcp-tokens/elevenlabs.json" "hermes mcp login elevenlabs"
    # Motion: the studio folder is created from templates/motion-studio the first time Motion opens.
    MS="$(PYTHONPATH="$HOME/hermes" python3 -c 'from hmem import motion; print(motion.studio_dir())' 2>/dev/null)"
    opt   "Motion: Node.js"           "command -v node" "bin/install-tool node"
    opt   "Motion: studio ready"      "test -d \"$MS/node_modules/remotion\"" "bin/setup --only motion, or open Motion in the WebUI"
    opt   "Motion: music (ElevenLabs key)" "grep -qE '^[[:space:]]*ELEVENLABS_API_KEY=[^[:space:]]+' \"$MS/.env\"" "add ELEVENLABS_API_KEY=… to $MS/.env"
    check "Attachments store"         "test -w ~/hermes/state"
    ;;
  services)
    python3 -I - <<'PY'
import importlib, importlib.util, os, sys
pkg = os.path.expanduser("~/hermes/plugin/command-centre")
spec = importlib.util.spec_from_file_location("cc", f"{pkg}/__init__.py", submodule_search_locations=[pkg])
sys.modules["cc"] = importlib.util.module_from_spec(spec)
got = importlib.import_module("cc.updates").ensure_services()
print("Installed: " + ", ".join(got) if got else "All services are installed.")
PY
    ;;
  restart)
    "$0" services | grep -v "^All services" || true
    hermes gateway restart >/dev/null 2>&1
    for s in webui caddy mdns; do launchctl kickstart -k "gui/$UID_/ai.hermes.$s"; done
    echo "restarted" ;;
  logs)
    case "${2:-webui}" in
      webui) tail -n 60 ~/.hermes/webui.log ;;
      gateway) tail -n 60 ~/.hermes/logs/gateway.log ;;
      caddy) tail -n 40 ~/hermes/state/logs/caddy-server.log 2>/dev/null || tail -n 40 ~/hermes/state/logs/caddy.log ;;
      mdns) tail -n 20 ~/hermes/state/logs/mdns.log ;;
      sidecar|cc-sidecar) tail -n 40 ~/hermes/state/logs/cc-sidecar.log ;;
      decisions) tail -n 30 ~/hermes/state/decisions.jsonl ;;
    esac ;;
  import) uv run --no-project -q --with ruamel.yaml python ~/hermes/bin/cc-import-projects "${@:2}" ;;
  limits) python3 ~/hermes/plugin/limits/__init__.py "${@:2}" ;;
  update)
    PY=(python3); command -v uv >/dev/null && PY=(uv run -q --no-project --with ruamel.yaml python)
    "${PY[@]}" - <<'PY'
import importlib.util, os, sys, time
pkg = os.path.expanduser("~/hermes/plugin/command-centre")
spec = importlib.util.spec_from_file_location("cc", f"{pkg}/__init__.py", submodule_search_locations=[pkg])
sys.modules["cc"] = importlib.util.module_from_spec(spec)  # submodules only; the Hermes plugin itself isn't loaded
import importlib
u = importlib.import_module("cc.updates")
got = u.ensure_services()
if got:
    print("Installed missing services: " + ", ".join(got))
try:
    sys.stdin = open("/dev/tty")  # stdin is this script; questions go to the terminal
except OSError:
    pass  # no terminal (cron, CI): every question answers no
ask = lambda q: sys.stdin.isatty() and input(f"{q} [y/N] ").strip().lower().startswith("y")
if u.pending_restart():
    print("An update was downloaded but its services haven't restarted yet.")
else:
    r = u.check(force=True)
    if not r["available"]:
        print(r["note"] or f"Tabbie is up to date ({r['local'][:7]})."); sys.exit(0)
    n = r["ahead_by"] or len(r["commits"])
    print(f"Tabbie update available{f': {n} change' + ('s' if n != 1 else '') if n else ''}")
    for c in r["commits"][:10]:
        print(f"  • {c['title']}")
    if not ask("Download it now? Your settings and edited files stay as they are."):
        print("Skipped."); sys.exit(0)
    res = u.apply()
    if not res["ok"]:
        print(res["error"]); sys.exit(1)
    print(f"Updated {res['from']} → {res['to']} ({res['files']} files).")
    if "setup" in res["needs"]:
        print("This update changed setup steps: run bin/setup when convenient.")
    if "reload" in res["needs"]:
        print("Reload the WebUI in your browser to get the new interface.")
if u.pending_restart():
    if not ask("Restart Tabbie's services now to finish? (waits if a request is running)"):
        print("Later: bin/hub update"); sys.exit(0)
    if u.busy():
        # the sidecar watches for idle and restarts then (updates.resume on its start)
        st = u._state(); st["restart_when_idle"] = True; u._save_state(st)
        os.system(f"launchctl kickstart -k gui/{os.getuid()}/ai.hermes.cc-sidecar >/dev/null 2>&1")
        print("Something is running (a request, a worker or a Motion render). Tabbie restarts by itself once it's idle.")
        sys.exit(0)
    need = u.pending_restart()
    res = u.restart(after_reply=lambda: os.system(f"launchctl kickstart -k gui/{os.getuid()}/ai.hermes.cc-sidecar >/dev/null 2>&1"))
    print("Restarted: " + ", ".join(res.get("restarted") or need) if res["ok"] else res["error"])
PY
    ;;
  *) sed -n 2,9p "$0" ;;
esac
