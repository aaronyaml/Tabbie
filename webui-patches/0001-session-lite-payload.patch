index 000000000..ac5677db4
--- /dev/null
+++ b/tests/test_hermes_patch_0001_lite_payload.py
@@ -0,0 +1,89 @@
+"""Hermes patch 0001: ?hx_strip_images=1 and ?msg_bytes=N on GET /api/session."""
+import copy
+
+from tests.test_session_tail_payload import _FakeSession, _invoke
+
+BIG = "data:image/png;base64," + "A" * 200_000
+
+
+def _img_msg(text="see attached"):
+    return {
+        "role": "user",
+        "content": [
+            {"type": "text", "text": text},
+            {"type": "image_url", "image_url": {"url": BIG}},
+        ],
+    }
+
+
+def _q(extra):
+    return "session_id=tail_payload_001&messages=1&resolve_model=0&msg_limit=30" + extra
+
+
+def _convo(n, size=2_000):
+    msgs = []
+    for i in range(n):
+        msgs.append({"role": "user", "content": f"q{i} " + "x" * size})
+        msgs.append({"role": "assistant", "content": f"a{i} " + "y" * size})
+    return msgs
+
+
+def test_without_params_payload_is_unchanged():
+    session = _FakeSession([_img_msg(), {"role": "assistant", "content": "ok"}])
+    payload = _invoke(session, query=_q(""))
+    assert payload["messages"][0]["content"][1]["image_url"]["url"] == BIG
+
+
+def test_strip_images_stubs_inline_images_without_mutating_the_session():
+    session = _FakeSession([_img_msg(), {"role": "assistant", "content": "ok"}])
+    before = copy.deepcopy(session.messages)
+    payload = _invoke(session, query=_q("&hx_strip_images=1"))
+    part = payload["messages"][0]["content"][1]
+    assert part["type"] == "image_url"
+    assert part["image_url"]["url"] == ""
+    assert part["hx_omitted_bytes"] == len(BIG)
+    assert payload["messages"][0]["content"][0] == {"type": "text", "text": "see attached"}
+    assert session.messages == before
+
+
+def test_strip_images_keeps_remote_urls():
+    msg = {"role": "user", "content": [{"type": "image_url", "image_url": {"url": "https://x/y.png"}}]}
+    session = _FakeSession([msg, {"role": "assistant", "content": "ok"}])
+    payload = _invoke(session, query=_q("&hx_strip_images=1"))
+    assert payload["messages"][0]["content"][0]["image_url"]["url"] == "https://x/y.png"
+
+
+def test_msg_bytes_shrinks_a_fresh_tail_and_marks_it_truncated():
+    session = _FakeSession(_convo(20))  # 40 rows, ~2KB each
+    full = _invoke(session, query=_q(""))
+    small = _invoke(session, query=_q("&msg_bytes=20000"))
+    assert len(full["messages"]) == 30
+    assert 6 <= len(small["messages"]) < 30
+    assert small["messages"] == session.messages[-len(small["messages"]):]
+    assert small["_messages_truncated"] is True
+    assert small["_messages_offset"] == len(session.messages) - len(small["messages"])
+
+
+def test_msg_bytes_never_goes_below_the_row_floor():
+    session = _FakeSession(_convo(20, size=50_000))
+    payload = _invoke(session, query=_q("&msg_bytes=1000"))
+    assert len(payload["messages"]) == 6
+
+
+def test_msg_bytes_leaves_small_tails_alone():
+    session = _FakeSession(_convo(5, size=10))
+    payload = _invoke(session, query=_q("&msg_bytes=100000"))
+    assert payload["messages"] == session.messages
+
+
+def test_msg_bytes_is_ignored_for_msg_before_paging():
+    session = _FakeSession(_convo(20))
+    q = "session_id=tail_payload_001&messages=1&resolve_model=0&msg_before=30&msg_limit=10&msg_bytes=1000"
+    payload = _invoke(session, query=q)
+    assert payload["messages"] == session.messages[20:30]
+
+
+def test_bad_msg_bytes_value_is_ignored():
+    session = _FakeSession(_convo(20))
+    payload = _invoke(session, query=_q("&msg_bytes=lots"))
+    assert len(payload["messages"]) == 30
