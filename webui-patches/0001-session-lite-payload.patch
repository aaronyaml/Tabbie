+# Hermes patch (webui-patches/0001): helpers for ?hx_strip_images / ?msg_bytes.
+_HX_MIN_ROWS = 6
+_HX_IMAGE_PART_TYPES = {"image_url", "input_image", "image"}
+
+
+def _hx_inline_image_bytes(part) -> int:
+    """Size of an inline (data: / base64) image carried by a content part, else 0."""
+    if not isinstance(part, dict) or part.get("type") not in _HX_IMAGE_PART_TYPES:
+        return 0
+    for holder, key in ((part.get("image_url"), "url"), (part, "image_url"), (part, "url")):
+        value = holder.get(key) if isinstance(holder, dict) else None
+        if isinstance(value, str) and value.startswith("data:"):
+            return len(value)
+    source = part.get("source")
+    if isinstance(source, dict) and source.get("type") == "base64" and isinstance(source.get("data"), str):
+        return len(source["data"])
+    return 0
+
+
+def _hx_strip_inline_images(messages) -> list:
+    """Copy-on-write: replace inline image parts with a small stub. Never mutates inputs."""
+    out = []
+    for msg in messages or []:
+        content = msg.get("content") if isinstance(msg, dict) else None
+        if isinstance(content, list) and any(_hx_inline_image_bytes(p) for p in content):
+            parts = []
+            for part in content:
+                size = _hx_inline_image_bytes(part)
+                if size:
+                    parts.append({"type": part.get("type"), "image_url": {"url": ""}, "hx_omitted_bytes": size})
+                else:
+                    parts.append(part)
+            msg = dict(msg)
+            msg["content"] = parts
+        out.append(msg)
+    return out
+
+
+def _hx_payload_bytes(messages) -> int:
+    try:
+        return len(json.dumps(messages, ensure_ascii=False, default=str))
+    except (TypeError, ValueError):
+        return 0
+
+
